{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Silk",
  "version": "0.1.1",
  "identifier": "dev.silk.project",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Silk",
        "visible": false,
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "maximized": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173; img-src 'self' asset: http://asset.localhost https://asset.localhost data:; media-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; style-src 'self'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Local instant-replay clipping",
    "longDescription": "A Windows-first instant-replay recorder that keeps clips local and bounded.",
    "copyright": "Copyright Silk Project Contributors",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "compression": "lzma",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true,
    "resources": {
      "../../../licenses/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFERjAyMEE2RjM3QzU2QUUKUldTdVZuenpwaUR3cmJxNWhYVFJwN1g4TFREZ2J6MExnaWZlc2NEU1pXUlVqWTNEQkRrKzVFLy8K",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/TrulyScarlet/silk-studio/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
